<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_report_form" model="ir.ui.view">
        <field name="name">reveuse_resto.management_report.form</field>
        <field name="model">reveuse_resto.management_report</field>
        <field name="arch" type="xml">
            <form string="Cetak Laporan Stok">
                <group>
                    <group>
                        <field name="tanggal_mulai"/>
                    </group>
                    <group>
                        <field name="tanggal_akhir"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Cetak PDF Mutasi" type="object" class="btn-success"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_management_report" model="ir.actions.act_window">
        <field name="name">Laporan Mutasi Stok</field>
        <field name="res_model">reveuse_resto.management_report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> 
    </record>

    <menuitem
        id="menu_reveuse_resto_management_reports"
        name="Reports (Laporan Stok)"
        parent="reveuse_resto.menu_reveuse_resto_management"
        action="action_management_report"  
        sequence="20"
        groups="reveuse_resto.group_assistant_manager"
    />
</odoo>