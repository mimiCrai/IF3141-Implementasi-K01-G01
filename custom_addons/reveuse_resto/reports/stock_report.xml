<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stok_pdf" model="ir.actions.report">
        <field name="name">Laporan Mutasi Stok</field>
        <field name="model">reveuse_resto.management_report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reveuse_resto.report_stok_template</field>
        <field name="report_file">reveuse_resto.report_stok_template</field>
        <field name="binding_model_id" ref="model_reveuse_resto_management_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stok_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center" style="border-bottom: 2px solid #002845; margin-bottom: 20px;">
                        <h2>Laporan Mutasi Stok Bahan Baku</h2>
                    </div>
                    
                    <t t-foreach="docs" t-as="doc">
                        <p><strong>Periode Laporan:</strong> <span t-field="doc.tanggal_mulai"/> s/d <span t-field="doc.tanggal_akhir"/></p>
                        
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th>Tanggal</th>
                                    <th>Referensi</th>
                                    <th>Bahan Baku</th>
                                    <th class="text-right">Jumlah (Mutasi)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="mutasi_list" t-as="m">
                                    <tr>
                                        <td><span t-esc="m['tanggal']"/></td>
                                        <td>
                                            <span t-esc="m['ref']"/><br/>
                                            <small class="text-muted"><span t-esc="m['ket']"/></small>
                                        </td>
                                        <td><span t-esc="m['bahan']"/></td>
                                        <td class="text-right">
                                            <span t-if="m['tipe'] == 'masuk'" style="color: green; font-weight: bold;">
                                                + <span t-esc="m['qty']"/>
                                            </span>
                                            <span t-if="m['tipe'] == 'keluar'" style="color: red; font-weight: bold;">
                                                - <span t-esc="m['qty']"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>