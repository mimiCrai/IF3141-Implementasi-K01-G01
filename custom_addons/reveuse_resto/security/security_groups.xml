<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_reveuse_resto" model="ir.module.category">
        <field name="name">Reveuse Resto</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_warehouse" model="res.groups">
        <field name="name">Warehouse</field>
        <field name="category_id" ref="reveuse_resto.module_category_reveuse_resto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_kasir" model="res.groups">
        <field name="name">Kasir</field>
        <field name="category_id" ref="reveuse_resto.module_category_reveuse_resto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_kitchen" model="res.groups">
        <field name="name">Kitchen</field>
        <field name="category_id" ref="reveuse_resto.module_category_reveuse_resto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_assistant_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="reveuse_resto.module_category_reveuse_resto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
