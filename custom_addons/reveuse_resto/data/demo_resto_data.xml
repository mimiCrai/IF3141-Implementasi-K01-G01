<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_uom_milliliter" model="uom.uom">
        <field name="name">mL</field>
        <field name="category_id" ref="uom.product_uom_categ_vol"/>
        <field name="uom_type">smaller</field>
        <field name="factor">1000.0</field>
        <field name="rounding">0.01</field>
    </record>

    <record id="product_biji_kopi_espresso" model="product.product">
        <field name="name">Biji Kopi Espresso</field>
        <field name="detailed_type">product</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="uom_po_id" ref="uom.product_uom_kgm"/>
    </record>

    <record id="product_susu_fresh_milk" model="product.product">
        <field name="name">Susu Fresh Milk</field>
        <field name="detailed_type">product</field>
        <field name="uom_id" ref="uom.product_uom_litre"/>
        <field name="uom_po_id" ref="uom.product_uom_litre"/>
    </record>

    <record id="product_iced_kopi_susu" model="product.product">
        <field name="name">Iced Kopi Susu</field>
        <field name="detailed_type">product</field>
        <field name="available_in_pos">True</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
    </record>

    <record id="bom_iced_kopi_susu" model="mrp.bom">
        <field name="product_tmpl_id" search="[('name', '=', 'Iced Kopi Susu')]"/>
        <field name="product_qty">1.0</field>
        <field name="product_uom_id" ref="uom.product_uom_unit"/>
        <field name="type">phantom</field>
        <field name="bom_line_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'product_id': ref('reveuse_resto.product_biji_kopi_espresso'),
                'product_qty': 18.0,
                'product_uom_id': ref('uom.product_uom_gram'),
            }),
            (0, 0, {
                'product_id': ref('reveuse_resto.product_susu_fresh_milk'),
                'product_qty': 200.0,
                'product_uom_id': ref('reveuse_resto.product_uom_milliliter'),
            }),
        ]"/>
    </record>

    <record id="bahan_baku_biji_kopi_espresso" model="reveuse_resto.bahan_baku">
        <field name="name">Biji Kopi Espresso</field>
        <field name="kategori">minuman</field>
        <field name="product_id" ref="reveuse_resto.product_biji_kopi_espresso"/>
        <field name="satuan_id" ref="uom.product_uom_kgm"/>
        <field name="batas_minimum">1</field>
    </record>

    <record id="bahan_baku_susu_fresh_milk" model="reveuse_resto.bahan_baku">
        <field name="name">Susu Fresh Milk</field>
        <field name="kategori">minuman</field>
        <field name="product_id" ref="reveuse_resto.product_susu_fresh_milk"/>
        <field name="satuan_id" ref="uom.product_uom_litre"/>
        <field name="batas_minimum">2</field>
    </record>

    <record id="demo_user_manager" model="res.users">
        <field name="name">Assistant Manager</field>
        <field name="login">manager@reveuse.com</field>
        <field name="password">manager123</field> 
        <field name="groups_id" eval="[(4, ref('reveuse_resto.group_assistant_manager'))]"/>
    </record>

    <record id="demo_user_kasir" model="res.users">
        <field name="name">Kasir</field>
        <field name="login">kasir@reveuse.com</field>
        <field name="password">kasir123</field>
        <field name="groups_id" eval="[(4, ref('reveuse_resto.group_kasir'))]"/>
    </record>

    <record id="demo_user_kitchen" model="res.users">
        <field name="name">Kitchen</field>
        <field name="login">kitchen@reveuse.com</field>
        <field name="password">kitchen123</field>
        <field name="groups_id" eval="[(4, ref('reveuse_resto.group_kitchen'))]"/>
    </record>

    <record id="demo_user_warehouse" model="res.users">
        <field name="name">Warehouse</field>
        <field name="login">warehouse@reveuse.com</field>
        <field name="password">warehouse123</field>
        <field name="groups_id" eval="[(4, ref('reveuse_resto.group_warehouse'))]"/>
    </record>
</odoo>
