<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_report_form" model="ir.ui.view">
        <field name="name">reveuse_resto.management_report.form</field>
        <field name="model">reveuse_resto.management_report</field>
        <field name="arch" type="xml">
            <form string="Cetak Laporan Stok">
                <group>
                    <group>
                        <field name="tanggal_mulai" string="Periode Mulai"/>
                    </group>
                    <group>
                        <field name="tanggal_akhir" string="Periode Akhir"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" string="Lihat di Layar" type="object" class="btn-primary"/>
                    
                    <button name="action_print_pdf" string="Cetak PDF" type="object" class="btn-success"/>
                    
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_management_report" model="ir.actions.act_window">
        <field name="name">Laporan Stok</field>
        <field name="res_model">reveuse_resto.management_report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> </record>
</odoo>