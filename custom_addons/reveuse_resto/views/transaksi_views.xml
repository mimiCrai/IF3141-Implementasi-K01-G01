<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_transaksi_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.transaksi.tree.mock</field>
        <field name="model">reveuse_resto.transaksi</field>
        <field name="arch" type="xml">
            <tree string="Sales - Mocked Grid" create="0" edit="0" delete="0" class="reveuse-hidden-tree">
                <field name="name" string="Static Placeholder"/>
            </tree>
        </field>
    </record>

    <record id="view_transaksi_kanban" model="ir.ui.view">
        <field name="name">reveuse_resto.transaksi.kanban.mock</field>
        <field name="model">reveuse_resto.transaksi</field>
        <field name="arch" type="xml">
            <kanban class="reveuse-hidden-kanban" quick_create="0" create="0" edit="0" sample="1">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div>Static Mock</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_transaksi_form" model="ir.ui.view">
        <field name="name">reveuse_resto.transaksi.form.mock</field>
        <field name="model">reveuse_resto.transaksi</field>
        <field name="arch" type="xml">
            <form string="Riwayat Transaksi" create="0" edit="0" delete="0" class="reveuse-shell reveuse-page-sales">
                <sheet>
                    <div class="reveuse-page-head">
                        <h1>Riwayat Transaksi</h1>
                        <p>Static cashier console for demonstration and visual QA.</p>
                    </div>

                    <div class="reveuse-stat-row">
                        <div class="reveuse-stat-card">
                            <div class="reveuse-stat-label">Open Tickets</div>
                            <div class="reveuse-stat-value">8</div>
                        </div>
                        <div class="reveuse-stat-card">
                            <div class="reveuse-stat-label">Orders Processed</div>
                            <div class="reveuse-stat-value">126</div>
                        </div>
                    </div>

                    <div class="reveuse-panel">
                        <div class="reveuse-panel-title">Tree Mock - Riwayat Transaksi</div>
                        <table class="reveuse-mock-table">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Time</th>
                                    <th>Table</th>
                                    <th>Cashier</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>ORD-240423-001</td>
                                    <td>11:02</td>
                                    <td>T-03</td>
                                    <td>Kasir A</td>
                                    <td><span class="tag tag-good">Paid</span></td>
                                </tr>
                                <tr>
                                    <td>ORD-240423-004</td>
                                    <td>11:18</td>
                                    <td>T-07</td>
                                    <td>Kasir B</td>
                                    <td><span class="tag tag-warn">Waiting Kitchen</span></td>
                                </tr>
                                <tr>
                                    <td>ORD-240423-006</td>
                                    <td>11:26</td>
                                    <td>T-10</td>
                                    <td>Kasir A</td>
                                    <td><span class="tag tag-good">Paid</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="reveuse-panel">
                        <div class="reveuse-panel-title">Form Mock - Ticket Details</div>
                        <div class="reveuse-form-grid">
                            <div><strong>Order ID:</strong> ORD-240423-004</div>
                            <div><strong>Table:</strong> T-07</div>
                            <div><strong>Customer:</strong> Walk-In</div>
                            <div><strong>Payment:</strong> QRIS</div>
                            <div><strong>Items:</strong> 2x Steak, 1x Lemon Tea</div>
                            <div><strong>Total:</strong> Rp 248.000</div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transaksi" model="ir.actions.act_window">
        <field name="name">Riwayat Transaksi</field>
        <field name="res_model">reveuse_resto.transaksi</field>
        <field name="view_mode">form,tree,kanban</field>
        <field name="view_id" ref="view_transaksi_form"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
