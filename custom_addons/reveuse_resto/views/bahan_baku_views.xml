<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bahan_baku_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.tree.mock</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <tree string="Warehouse - Mocked Grid" create="0" edit="0" delete="0" class="reveuse-hidden-tree">
                <field name="name" string="Static Placeholder"/>
            </tree>
        </field>
    </record>

    <record id="view_bahan_baku_kanban" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.kanban.mock</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <kanban class="reveuse-hidden-kanban" quick_create="0" create="0" edit="0" sample="1">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div>Static Mock</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bahan_baku_form" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.form.mock</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <form string="Warehouse" create="0" edit="0" delete="0" class="reveuse-shell reveuse-page-warehouse">
                <sheet>
                    <div class="reveuse-page-head">
                        <h1>Warehouse Operations</h1>
                        <p>High-fidelity static prototype for stock room monitoring.</p>
                    </div>

                    <div class="reveuse-stat-row">
                        <div class="reveuse-stat-card">
                            <div class="reveuse-stat-label">Items Tracked</div>
                            <div class="reveuse-stat-value">42 SKU</div>
                        </div>
                        <div class="reveuse-stat-card">
                            <div class="reveuse-stat-label">Critical Stock</div>
                            <div class="reveuse-stat-value">3 Items</div>
                        </div>
                        <div class="reveuse-stat-card">
                            <div class="reveuse-stat-label">Restock ETA</div>
                            <div class="reveuse-stat-value">16:30</div>
                        </div>
                    </div>

                    <div class="reveuse-panel">
                        <div class="reveuse-panel-title">Tree Mock - Warehouse Grid</div>
                        <table class="reveuse-mock-table">
                            <thead>
                                <tr>
                                    <th>Ingredient</th>
                                    <th>Current Stock</th>
                                    <th>Minimum</th>
                                    <th>Zone</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Beef</td>
                                    <td>50 kg</td>
                                    <td>20 kg</td>
                                    <td>Cold Storage A</td>
                                    <td><span class="tag tag-good">Safe</span></td>
                                </tr>
                                <tr>
                                    <td>Tomato</td>
                                    <td>20 kg</td>
                                    <td>10 kg</td>
                                    <td>Veg Rack B</td>
                                    <td><span class="tag tag-good">Safe</span></td>
                                </tr>
                                <tr>
                                    <td>Cooking Oil</td>
                                    <td>15 liter</td>
                                    <td>12 liter</td>
                                    <td>Dry Shelf C</td>
                                    <td><span class="tag tag-warn">Low</span></td>
                                </tr>
                                <tr>
                                    <td>Chili Powder</td>
                                    <td>4 kg</td>
                                    <td>6 kg</td>
                                    <td>Spice Locker</td>
                                    <td><span class="tag tag-danger">Critical</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="reveuse-panel">
                        <div class="reveuse-panel-title">Kanban Mock - Restock Lanes</div>
                        <div class="reveuse-card-lane">
                            <div class="reveuse-app-card">
                                <h3>Restock Today</h3>
                                <p>Chicken Breast - 25 kg</p>
                                <p>Potato - 30 kg</p>
                            </div>
                            <div class="reveuse-app-card">
                                <h3>Pending Supplier</h3>
                                <p>Cheese Slice - 12 pack</p>
                                <p>Burger Bun - 120 pcs</p>
                            </div>
                            <div class="reveuse-app-card">
                                <h3>Quality Hold</h3>
                                <p>Lettuce - inspection at 15:00</p>
                                <p>Reason: moisture mismatch</p>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bahan_baku" model="ir.actions.act_window">
        <field name="name">Warehouse</field>
        <field name="res_model">reveuse_resto.bahan_baku</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_bahan_baku_tree_crud"/>
    </record>

    <record id="view_bahan_baku_tree_crud" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.tree.crud</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <tree string="Master Data Bahan Baku">
                <field name="name"/>
                <field name="id_bahan"/>
                <field name="kategori"/>
                <field name="product_id"/>
                <field name="stok_sekarang" readonly="1"/>
                <field name="batas_minimum"/>
                <field name="satuan_id"/>
            </tree>
        </field>
    </record>

    <record id="view_bahan_baku_form_crud" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.form.crud</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <form string="Master Data Bahan Baku">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="id_bahan"/>
                        <field name="kategori"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="stok_sekarang" readonly="1"/>
                        <field name="batas_minimum"/>
                        <field name="satuan_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bahan_baku_crud" model="ir.actions.act_window">
        <field name="name">Master Data Bahan Baku</field>
        <field name="res_model">reveuse_resto.bahan_baku</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_bahan_baku_tree_crud"/>
    </record>
</odoo>
