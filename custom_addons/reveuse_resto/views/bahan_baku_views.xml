<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bahan_baku_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.tree.mock</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <tree string="Warehouse - Mocked Grid" create="0" edit="0" delete="0" class="reveuse-hidden-tree">
                <field name="name" string="Static Placeholder"/>
            </tree>
        </field>
    </record>

    <record id="view_bahan_baku_kanban" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.kanban.mock</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <kanban class="reveuse-hidden-kanban" quick_create="0" create="0" edit="0" sample="1">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div>Static Mock</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bahan_baku_form" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.form.mock</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <form string="Beranda" create="0" edit="0" delete="0" class="reveuse-shell">
                <sheet>
                    <div class="text-center" style="margin-top: 80px; margin-bottom: 80px;">
                        <h1 style="font-size: 42px; color: #002845; font-weight: 800; margin-bottom: 10px;">
                            Selamat Datang di Sistem Informasi<br/>Reveuse Resto
                        </h1>
                        <p style="font-size: 18px; color: #555;">
                            Silakan gunakan menu navigasi di bagian atas untuk mengelola Inventaris, Dapur, Kasir, dan Laporan.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bahan_baku" model="ir.actions.act_window">
        <field name="name">Beranda</field>
        <field name="res_model">reveuse_resto.bahan_baku</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_bahan_baku_tree_crud"/>
    </record>

    <record id="view_bahan_baku_tree_crud" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.tree.crud</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <tree string="Master Data Bahan Baku">
                <field name="name"/>
                <field name="id_bahan"/>
                <field name="kategori"/>
                <field name="product_id"/>
                <field name="stok_sekarang" readonly="1"/>
                <field name="batas_minimum"/>
                <field name="satuan_id"/>
            </tree>
        </field>
    </record>

    <record id="view_bahan_baku_form_crud" model="ir.ui.view">
        <field name="name">reveuse_resto.bahan_baku.form.crud</field>
        <field name="model">reveuse_resto.bahan_baku</field>
        <field name="arch" type="xml">
            <form string="Master Data Bahan Baku">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="id_bahan"/>
                        <field name="kategori"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="stok_sekarang" readonly="1"/>
                        <field name="batas_minimum"/>
                        <field name="satuan_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bahan_baku_crud" model="ir.actions.act_window">
        <field name="name">Master Data Bahan Baku</field>
        <field name="res_model">reveuse_resto.bahan_baku</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_bahan_baku_tree_crud"/>
    </record>
</odoo>