<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_management_overview_form" model="ir.ui.view">
        <field name="name">reveuse_resto.management_overview.form</field>
        <field name="model">reveuse_resto.management_overview</field>
        <field name="arch" type="xml">
            <form string="Managerial Overview" class="reveuse-shell" create="false" edit="false" delete="false">
                <sheet>
                    <div class="reveuse-page-head">
                        <h1>Managerial Control Center</h1>
                        <p>Overview performa cabang dan kontrol akses user.</p>
                    </div>

                    <div class="reveuse-stat-row">
                        <div class="reveuse-stat-card">
                            <div class="reveuse-stat-label">Active Staff</div>
                            <div class="reveuse-stat-value">
                                <field name="total_staff"/> Users
                            </div>
                        </div>
                    </div>

                    <div class="reveuse-panel">
                        <div class="reveuse-panel-title">User Access Control</div>
                        <p class="text-muted">Kelola peran staff dan perizinan modul secara langsung.</p>
                        
                        <field name="pengguna_ids">
                            <tree create="0" delete="0" edit="0" decoration-info="peran == 'manager'" decoration-warning="peran == 'kasir'">
                                <field name="name" string="Staff Name"/>
                                <field name="email" string="Email"/>
                                <field name="no_telp" string="No. Telp"/>
                                <field name="status_notif" string="Notification" widget="boolean_toggle"/>
                                <field name="peran" string="Assigned Role" widget="badge" 
                                       decoration-info="peran == 'manager'" 
                                       decoration-warning="peran == 'kasir'"
                                       decoration-success="peran == 'kitchen'"
                                       decoration-danger="peran == 'warehouse'"/>                                
                                <button name="action_open_user_detail" string="Manage Access" type="object" class="btn-primary" icon="fa-gears"/>
                            </tree>
                        </field>
                    </div>

                    <div class="reveuse-panel" style="border-top: 1px solid #eee; margin-top: 20px; padding-top: 15px;">
                        <div class="reveuse-panel-title">System Logs &amp; Integrity (CR-4)</div>
                        <div class="reveuse-form-grid" style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong>Last Security Audit:</strong> 24 April 2026<br/>
                                <strong>Unauthorized Attempts:</strong> 0
                            </div>
                            <span class="btn btn-danger" style="background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">
                                Reset All Staff Session Tokens
                            </span>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_management_overview" model="ir.actions.act_window">
        <field name="name">Managerial Overview</field>
        <field name="res_model">reveuse_resto.management_overview</field>
        <field name="view_mode">form</field>
    </record>
</odoo>