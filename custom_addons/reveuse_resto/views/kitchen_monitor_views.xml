<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_kitchen_order_monitor_kanban" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.order.monitor.kanban.mock</field>
        <field name="model">reveuse_resto.kitchen_order</field>
        <field name="arch" type="xml">
            <kanban class="reveuse-kitchen-kanban" sample="1" quick_create="0" create="0" edit="0" delete="0">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card reveuse-kitchen-card">
                            <div class="reveuse-kitchen-ticket-id">Kitchen Ticket</div>
                            <h3>ORD-240423-004</h3>
                            <div class="reveuse-kitchen-meta">Table T-07</div>
                            <div class="reveuse-kitchen-meta">Elapsed 00:12</div>
                            <div class="reveuse-kitchen-meta">Items: Steak, Lemon Tea</div>
                            <div class="reveuse-kitchen-actions">
                                <span class="tag tag-warn">Waiting</span>
                            </div>
                            <button type="action" name="%(action_kitchen_ingredient_form)d" string="Edit Ingredients" class="btn btn-primary mt8"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kitchen_order_monitor_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.order.monitor.tree.mock</field>
        <field name="model">reveuse_resto.kitchen_order</field>
        <field name="arch" type="xml">
            <tree string="Kitchen - Mocked Grid" create="0" edit="0" delete="0" class="reveuse-hidden-tree">
                <field name="name" string="Static Placeholder"/>
            </tree>
        </field>
    </record>

    <record id="view_kitchen_order_monitor_form" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.order.monitor.form.mock</field>
        <field name="model">reveuse_resto.kitchen_order</field>
        <field name="arch" type="xml">
            <form string="Daftar Pesanan" create="0" edit="0" delete="0" class="reveuse-shell reveuse-page-kitchen">
                <sheet>
                    <div class="reveuse-page-head">
                        <h1>Kitchen Order Monitor</h1>
                        <p>Live tracking of incoming food orders and preparation status.</p>
                    </div>

                    <div class="reveuse-kitchen-lanes">
                        <div class="reveuse-lane">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 style="color: var(--rv-accent);">Waiting</h2>
                                <span class="badge rounded-pill" style="background: var(--rv-bg); color: var(--rv-accent); border: 1px solid var(--rv-accent);">2 Orders</span>
                            </div>
                            
                            <div class="reveuse-kitchen-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="reveuse-kitchen-ticket-id">ORD-240423-009</div>
                                    <span class="tag tag-warn">00:05</span>
                                </div>
                                <h3>Table T-02</h3>
                                <div class="reveuse-kitchen-meta">
                                    <ul style="padding-left: 1.2rem; margin: 8px 0;">
                                        <li>Nasi Goreng x2</li>
                                        <li>Es Teh x2</li>
                                    </ul>
                                </div>
                                <button type="action" name="%(action_kitchen_ingredient_form)d" 
                                        string="Process Order" class="btn btn-primary w-100 mt-2"/>
                            </div>

                            <div class="reveuse-kitchen-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="reveuse-kitchen-ticket-id">ORD-240423-016</div>
                                    <span class="tag tag-warn">00:03</span>
                                </div>
                                <h3>Table T-08</h3>
                                <div class="reveuse-kitchen-meta">
                                    <ul style="padding-left: 1.2rem; margin: 8px 0;">
                                        <li>Chicken Burger x2</li>
                                        <li>Iced Coffee x2</li>
                                    </ul>
                                </div>
                                <button type="action" name="%(action_kitchen_ingredient_form)d" 
                                        string="Process Order" class="btn btn-primary w-100 mt-2"/>
                            </div>
                        </div>

                        <div class="reveuse-lane">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 style="color: var(--rv-ok);">On Progress</h2>
                                <span class="badge rounded-pill" style="background: #f0fdf4; color: var(--rv-ok); border: 1px solid var(--rv-ok);">2 Orders</span>
                            </div>

                            <div class="reveuse-kitchen-card" style="border-left: 4px solid var(--rv-ok);">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="reveuse-kitchen-ticket-id">ORD-240423-012</div>
                                    <span class="tag tag-danger">00:14</span>
                                </div>
                                <h3>Table T-11</h3>
                                <div class="reveuse-kitchen-meta">
                                    <ul style="padding-left: 1.2rem; margin: 8px 0;">
                                        <li>Steak Medium x3</li>
                                        <li>Fries Large x2</li>
                                    </ul>
                                </div>
                                <button type="action" name="%(action_kitchen_ingredient_form)d" 
                                        string="Mark as Done" class="btn btn-success w-100 mt-2"/>
                            </div>

                            <div class="reveuse-kitchen-card" style="border-left: 4px solid var(--rv-ok);">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="reveuse-kitchen-ticket-id">ORD-240423-014</div>
                                    <span class="tag tag-danger">00:10</span>
                                </div>
                                <h3>Table T-05</h3>
                                <div class="reveuse-kitchen-meta">
                                    <ul style="padding-left: 1.2rem; margin: 8px 0;">
                                        <li>Spicy Ramen x2</li>
                                        <li>Mineral Water x2</li>
                                    </ul>
                                </div>
                                <button type="action" name="%(action_kitchen_ingredient_form)d" 
                                        string="Mark as Done" class="btn btn-success w-100 mt-2"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kitchen_ingredient_usage_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.ingredient.usage.tree</field>
        <field name="model">reveuse_resto.kitchen_ingredient_usage</field>
        <field name="arch" type="xml">
            <tree string="Penggunaan Bahan" create="0" edit="0" delete="0">
                <field name="usage_datetime"/>
                <field name="pos_reference"/>
                <field name="menu_product_id"/>
                <field name="menu_qty"/>
                <field name="ingredient_product_id"/>
                <field name="qty_used"/>
                <field name="uom_id"/>
            </tree>
        </field>
    </record>

    <record id="view_kitchen_ingredient_usage_form" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.ingredient.usage.form</field>
        <field name="model">reveuse_resto.kitchen_ingredient_usage</field>
        <field name="arch" type="xml">
            <form string="Penggunaan Bahan" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="usage_datetime"/>
                        <field name="pos_reference"/>
                        <field name="menu_product_id"/>
                        <field name="menu_qty"/>
                        <field name="ingredient_product_id"/>
                        <field name="qty_used"/>
                        <field name="uom_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kitchen_ingredient_form" model="ir.actions.act_window">
        <field name="name">Penggunaan Bahan</field>
        <field name="res_model">reveuse_resto.kitchen_ingredient_usage</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_kitchen_ingredient_usage_tree"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="action_kitchen_order_monitor" model="ir.actions.act_window">
        <field name="name">Daftar Pesanan</field>
        <field name="res_model">reveuse_resto.kitchen_order</field>
        <field name="view_mode">form,kanban,tree</field>
        <field name="view_id" ref="view_kitchen_order_monitor_form"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
