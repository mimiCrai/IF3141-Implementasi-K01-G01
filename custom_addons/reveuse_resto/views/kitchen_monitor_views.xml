<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_kitchen_ingredient_usage_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.ingredient.usage.tree</field>
        <field name="model">reveuse_resto.kitchen_ingredient_usage</field>
        <field name="arch" type="xml">
            <tree string="Penggunaan Bahan" create="0" edit="0" delete="0">
                <field name="usage_datetime" string="Waktu" widget="datetime"/>
                <field name="pos_reference" string="Ref. Transaksi" decoration-bf="1"/>
                
                <field name="ingredient_product_id" string="Bahan Terpakai"/>
                <field name="qty_used" string="Kuantitas Terpakai" sum="Total Kuantitas"/>
                <field name="uom_id" string="Satuan"/>
                
                </tree>
        </field>
    </record>

    <record id="view_kitchen_ingredient_usage_form" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.ingredient.usage.form</field>
        <field name="model">reveuse_resto.kitchen_ingredient_usage</field>
        <field name="arch" type="xml">
            <form string="Penggunaan Bahan" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="pos_reference"/></h1>
                    </div>
                    <group>
                        <group string="Informasi Order">
                            <field name="usage_datetime"/>
                            <field name="menu_product_id"/>
                            <field name="menu_qty"/>
                        </group>
                        <group string="Kalkulasi Bahan">
                            <field name="ingredient_product_id"/>
                            <label for="qty_used" string="Jumlah Terpakai"/>
                            <div class="o_row">
                                <field name="qty_used"/>
                                <field name="uom_id"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kitchen_ingredient_form" model="ir.actions.act_window">
        <field name="name">Penggunaan Bahan</field>
        <field name="res_model">reveuse_resto.kitchen_ingredient_usage</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_kitchen_ingredient_usage_tree"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="view_kitchen_order_monitor_kanban" model="ir.ui.view">
        <field name="name">reveuse_resto.kitchen.order.monitor.kanban</field>
        <field name="model">reveuse_resto.kitchen_order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_dashboard" records_draggable="true">
                <field name="name"/>
                <field name="table_number"/>
                <field name="item_summary"/>
                <field name="ingredients_needed"/>
                <field name="elapsed_display"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title" style="font-size: 16px; color: #3b82f6;">
                                        <field name="table_number"/>
                                    </strong>
                                    <br/>
                                    <small class="text-muted"><field name="name"/></small>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <span class="badge text-bg-warning"><field name="elapsed_display"/></span>
                                </div>
                            </div>
                            
                            <hr class="mt4 mb4"/>
                            
                            <div class="o_kanban_record_body">
                                <strong>Orders:</strong>
                                <div class="text-muted mb-2"><field name="item_summary"/></div>
                                
                                <strong>Ingredients Needed:</strong>
                                <div style="white-space: pre-wrap; font-size: 12px; color: #dc3545;">
                                    <field name="ingredients_needed"/>
                                </div>
                            </div>

                            <div class="o_kanban_record_bottom mt-3 pt-2" style="border-top: 1px solid #eee;">
                                <t t-if="record.status.raw_value == 'waiting'">
                                    <button type="object" name="action_start_progress" class="btn btn-primary btn-sm w-100">
                                        <i class="fa fa-fire"/> Mulai Masak
                                    </button>
                                </t>
                                <t t-if="record.status.raw_value == 'on_progress'">
                                    <button type="object" name="action_mark_done" class="btn btn-success btn-sm w-100">
                                        <i class="fa fa-check"/> Selesai
                                    </button>
                                </t>
                                <t t-if="record.status.raw_value == 'done'">
                                    <div class="text-success text-center w-100 font-weight-bold">
                                        <i class="fa fa-check-circle"/> Siap Disajikan
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_kitchen_order_monitor" model="ir.actions.act_window">
        <field name="name">Kitchen Board</field>
        <field name="res_model">reveuse_resto.kitchen_order</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_kitchen_order_monitor_kanban"/>
    </record>
</odoo>