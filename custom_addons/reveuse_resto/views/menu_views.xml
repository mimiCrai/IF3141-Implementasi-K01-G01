<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem
        id="menu_reveuse_resto_root"
        name="Reveuse Resto"
        sequence="10"
        groups="reveuse_resto.group_warehouse,reveuse_resto.group_kitchen,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_inventaris"
        name="Warehouse"
        parent="menu_reveuse_resto_root"
        action="action_bahan_baku"
        sequence="20"
        groups="reveuse_resto.group_warehouse,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_inventaris_master_data"
        name="Master Data Bahan Baku"
        parent="menu_reveuse_resto_inventaris"
        action="action_bahan_baku_crud"
        sequence="10"
        groups="reveuse_resto.group_warehouse,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_penerimaan"
        name="Penerimaan Bahan"
        parent="menu_reveuse_resto_inventaris"
        action="action_penerimaan"
        sequence="20"
        groups="reveuse_resto.group_warehouse,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_kitchen_monitor"
        name="Kitchen Staff"
        parent="menu_reveuse_resto_root"
        action="action_kitchen_order_monitor"
        sequence="40"
        groups="reveuse_resto.group_kitchen,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_kitchen_board"
        name="Board (Waiting / On Progress)"
        parent="menu_reveuse_resto_kitchen_monitor"
        action="action_kitchen_order_monitor"
        sequence="10"
        groups="reveuse_resto.group_kitchen,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_kitchen_ingredient_form"
        name="Penggunaan Bahan"
        parent="menu_reveuse_resto_kitchen_monitor"
        action="action_kitchen_ingredient_form"
        sequence="20"
        groups="reveuse_resto.group_kitchen,reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_management"
        name="Manajer"
        parent="menu_reveuse_resto_root"
        sequence="50"
        groups="reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_management_overview"
        name="Managerial Overview"
        parent="menu_reveuse_resto_management"
        action="action_management_overview"
        sequence="10"
        groups="reveuse_resto.group_assistant_manager"
    />

    <record id="view_pengguna_tree" model="ir.ui.view">
        <field name="name">reveuse_resto.pengguna.tree</field>
        <field name="model">reveuse_resto.pengguna</field>
        <field name="arch" type="xml">
            <tree string="Daftar Staff">
                <field name="name" string="Nama Lengkap"/>
                <field name="id_pengguna" string="ID Pengguna (Login)"/>
                <field name="email" string="Email"/>
                <field name="peran" string="Peran" widget="badge" 
                       decoration-info="peran == 'manager'" 
                       decoration-warning="peran == 'kasir'"
                       decoration-success="peran == 'kitchen'"
                       decoration-danger="peran == 'warehouse'"/>
            </tree>
        </field>
    </record>

    <record id="view_pengguna_form" model="ir.ui.view">
        <field name="name">reveuse_resto.pengguna.form</field>
        <field name="model">reveuse_resto.pengguna</field>
        <field name="arch" type="xml">
            <form string="Detail Staff">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nama Lengkap"/></h1>
                    </div>
                    <group>
                        <group string="Informasi Login">
                            <field name="id_pengguna"/>
                            <field name="email"/>
                            <field name="password" password="True"/>
                        </group>
                        <group string="Hak Akses &amp; Kontak">
                            <field name="peran"/>
                            <field name="no_telp"/>
                            <field name="status_notif"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pengguna_crud" model="ir.actions.act_window">
        <field name="name">Kelola Data Staff</field>
        <field name="res_model">reveuse_resto.pengguna</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_reveuse_resto_pengguna_crud"
        name="Data Staff (Access Control)"
        parent="menu_reveuse_resto_management"
        action="action_pengguna_crud"
        sequence="15"
        groups="reveuse_resto.group_assistant_manager"
    />

    <menuitem
        id="menu_reveuse_resto_management_reports"
        name="Reports (Laporan Stok)"
        parent="menu_reveuse_resto_management"
        action="action_management_report"  
        sequence="20"
        groups="reveuse_resto.group_assistant_manager"
    />
</odoo>